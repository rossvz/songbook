<div class="max-w-xl mx-auto py-8 animate-fade-in">
  <!-- Profile Section -->
  <div class="text-center mb-8">
    <div class="flex justify-center gap-4 mb-6">
      <div class="w-12 h-12 rounded-full glass flex items-center justify-center animate-float">
        <.icon name="hero-musical-note" class="w-6 h-6 text-accent" />
      </div>
      <div class="w-12 h-12 rounded-full glass flex items-center justify-center animate-float" style="animation-delay: 0.2s;">
        <.icon name="hero-speaker-wave" class="w-6 h-6 text-accent" />
      </div>
      <div class="w-12 h-12 rounded-full glass flex items-center justify-center animate-float" style="animation-delay: 0.4s;">
        <.icon name="hero-microphone" class="w-6 h-6 text-accent" />
      </div>
    </div>

    <p class="text-lg text-secondary leading-relaxed px-4">
      I am a singer & guitar player in the Atlanta, Georgia area where I perform
      acoustic covers at local restaurants and private events. Thank you for using
      this app! I hope it will be a fun way for us to interact during our time together.
    </p>
  </div>

  <!-- Tip Jar Section -->
  <div class="glass rounded-2xl p-6 mb-8 text-center">
    <h3 class="font-display text-xl font-semibold text-primary mb-2 flex items-center justify-center gap-2">
      <.icon name="hero-heart-solid" class="w-5 h-5 text-rose-500 animate-pulse-soft" />
      <span>Tip Jar</span>
      <.icon name="hero-heart-solid" class="w-5 h-5 text-rose-500 animate-pulse-soft" />
    </h3>

    <p class="text-secondary mb-4">
      If you're enjoying the music and would like to show your support, tips are
      always appreciated but never expected!
    </p>

    <a
      href="https://linktr.ee/MyTipJar"
      target="_blank"
      rel="noopener noreferrer"
      class="tip-jar-button inline-flex items-center gap-2"
    >
      <.icon name="hero-currency-dollar" class="w-5 h-5" />
      <span>Leave a Tip</span>
    </a>
  </div>

  <!-- Quote Section -->
  <div class="text-center mb-8 px-4">
    <p class="text-xl font-medium text-primary border-l-4 border-r-4 border-accent px-4 py-2 inline-block">
      Grab some food, pull up a chair, and let's sing some songs.
    </p>
    <p class="text-accent italic mt-3 font-display">— Randy Godwin</p>
  </div>

  <!-- Social Links Section -->
  <div class="flex justify-center gap-4">
    <a
      href="https://www.instagram.com/randy.godwin.music/"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button"
    >
      <span>Instagram</span>
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" />
      </svg>
    </a>

    <a
      href="https://www.facebook.com/randygodwinmusic"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button"
    >
      <span>Facebook</span>
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
      </svg>
    </a>
  </div>
</div>
