<div class="mb-8 border-b border-glass animate-fade-in">
  <nav class="flex gap-1" aria-label="Admin">
    <.link
      navigate={~p"/admin/songs"}
      class="admin-nav-tab admin-nav-tab-active"
    >
      <.icon name="hero-musical-note" class="h-4 w-4 inline-block mr-1.5" /> Songs
    </.link>
    <.link
      navigate={~p"/admin/shows"}
      class="admin-nav-tab"
    >
      <.icon name="hero-calendar-days" class="h-4 w-4 inline-block mr-1.5" /> Shows
    </.link>
    <.link
      navigate={~p"/admin/quick-searches"}
      class="admin-nav-tab"
    >
      <.icon name="hero-magnifying-glass" class="h-4 w-4 inline-block mr-1.5" /> Quick Searches
    </.link>
  </nav>
</div>

<!-- Spotify Playlist Section -->
<div class="mb-8 admin-card p-6 animate-scale-in" style="animation-delay: 0.05s;">
  <div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-3">
      <div class="p-2.5 rounded-xl" style="background: var(--accent-primary-soft);">
        <.icon name="hero-musical-note" class="h-5 w-5 text-accent" />
      </div>
      <h2 class="text-lg font-display font-semibold text-primary">
        Spotify Playlist
      </h2>
    </div>

    <%= if @playlist do %>
      <div class="flex items-center gap-2">
        <button
          phx-click="sync_playlist"
          class="px-3 py-1.5 text-xs font-medium text-secondary bg-glass border border-glass rounded-lg hover:bg-glass-hover hover:text-primary transition-all duration-200"
        >
          <.icon name="hero-arrow-path" class="h-3.5 w-3.5 mr-1 inline-block" /> Sync
        </button>
        <button
          phx-click="unlink_playlist"
          data-confirm="Are you sure you want to unlink this playlist?"
          class="px-3 py-1.5 text-xs font-medium text-tertiary hover:text-secondary hover:bg-glass border border-transparent rounded-lg transition-all duration-200"
        >
          <.icon name="hero-x-mark" class="h-3.5 w-3.5 mr-1 inline-block" /> Unlink
        </button>
      </div>
    <% else %>
      <.link patch={~p"/admin/songs/link-playlist"}>
        <button class="admin-button-primary">
          <.icon name="hero-link" class="h-4 w-4 mr-1.5" /> Link Playlist
        </button>
      </.link>
    <% end %>
  </div>

  <%= if @playlist do %>
    <div class="flex items-start gap-5 p-4 rounded-xl bg-glass/50 backdrop-blur-xl">
      <img
        :if={@playlist.image_url}
        src={@playlist.image_url}
        alt={@playlist.name}
        class="h-20 w-20 rounded-xl object-cover"
      />
      <div class="flex-1">
        <h3 class="font-semibold text-primary mb-1">
          {@playlist.name}
        </h3>
        <div class="flex items-center gap-3 mb-2">
          <span class="admin-badge-success">
            {@playlist.track_count} tracks
          </span>
        </div>
        <p class="text-xs text-tertiary mb-2">
          Last synced:
          <.local_time
            id="last-synced-time"
            datetime={@playlist.last_synced_at}
            class="font-medium text-secondary"
          />
        </p>
        <a
          href={@playlist.external_url}
          target="_blank"
          class="inline-flex items-center text-sm font-medium text-accent hover:opacity-80 transition-opacity"
        >
          <.icon name="hero-arrow-top-right-on-square" class="h-4 w-4 mr-1" /> View on Spotify
        </a>
      </div>
    </div>
  <% else %>
    <div class="p-5 rounded-xl border-2 border-dashed border-glass text-center">
      <.icon name="hero-musical-note" class="h-8 w-8 mx-auto mb-2 text-tertiary" />
      <p class="text-sm text-secondary">
        No playlist linked. Link a Spotify playlist to sync your songs.
      </p>
    </div>
  <% end %>
</div>

<!-- Song Library Header -->
<div
  class="mb-6 flex items-center justify-between animate-slide-up"
  style="animation-delay: 0.1s;"
>
  <div>
    <h1 class="text-2xl font-display font-semibold text-primary">
      Song Library
    </h1>
    <p class="mt-1 text-sm text-secondary">
      Manage your music collection and votes
    </p>
  </div>
  <div class="flex items-center gap-2">
    <button
      phx-click="reset_votes"
      class="admin-button-danger text-sm py-2 px-4"
    >
      <.icon name="hero-arrow-path" class="h-3.5 w-3.5 mr-1" /> Reset Votes
    </button>
    <.link patch={~p"/admin/songs/new"}>
      <button class="admin-button-secondary text-sm py-2 px-4">
        <.icon name="hero-plus" class="h-3.5 w-3.5 mr-1" /> New Song
      </button>
    </.link>
  </div>
</div>

<!-- Songs Grid -->
<div
  id="songs"
  phx-update="stream"
  phx-hook="StaggerList"
  class="space-y-4"
>
  <div
    :for={{id, song} <- @streams.songs}
    id={id}
    data-stagger
    class={[
      "song-card group",
      song.hidden? && "opacity-50"
    ]}
  >
    <!-- Subtle album blur for admin cards too -->
    <%= if song.album_artwork_url do %>
      <div
        class="song-card-blur-bg opacity-30"
        style={"background-image: url('#{song.album_artwork_url}');"}
      >
      </div>
    <% end %>

    <div class="song-card-content p-5">
      <div class="flex items-start gap-5">
        <.album_artwork url={song.album_artwork_url} alt={song.album} size="large" />

        <div class="flex-1 min-w-0">
          <.song_info song={song} />

          <%= if song.hidden? do %>
            <span class="admin-badge-warning text-xs mt-1 inline-block">
              <.icon name="hero-eye-slash-mini" class="h-3 w-3 mr-1" /> Hidden
            </span>
          <% end %>
        </div>

        <div class="flex items-center gap-4 flex-shrink-0">
          <.vote_count count={song.vote_count} />

          <div class="flex items-center gap-1.5 pl-4 border-l border-glass">
            <button
              type="button"
              phx-click="toggle_visibility"
              phx-value-id={song.id}
              class={[
                "p-2.5 rounded-xl transition-all duration-200",
                if song.hidden? do
                  "text-tertiary hover:text-primary hover:bg-accent-soft"
                else
                  "text-accent hover:bg-accent-soft"
                end
              ]}
              title={if song.hidden?, do: "Show song", else: "Hide song"}
            >
              <.icon
                name={if song.hidden?, do: "hero-eye-slash", else: "hero-eye"}
                class="h-5 w-5"
              />
            </button>
            <button
              type="button"
              phx-click="delete"
              phx-value-id={song.id}
              data-confirm="Delete this song?"
              class="p-2.5 rounded-xl text-tertiary hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all duration-200"
              title="Delete song"
            >
              <.icon name="hero-trash" class="h-5 w-5" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Empty state -->
<%= if @streams.songs.inserts == [] do %>
  <div class="glass rounded-2xl p-12 text-center animate-scale-in">
    <div
      class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center"
      style="background: var(--accent-primary-soft);"
    >
      <.icon name="hero-musical-note" class="w-8 h-8 text-accent" />
    </div>
    <h3 class="font-display text-xl font-semibold text-primary">No songs yet</h3>
    <p class="text-secondary mt-2 mb-4">Add songs manually or link a Spotify playlist.</p>
    <.link patch={~p"/admin/songs/new"}>
      <button class="admin-button-primary">
        <.icon name="hero-plus" class="h-4 w-4 mr-1.5" /> Add Your First Song
      </button>
    </.link>
  </div>
<% end %>

<.modal :if={@live_action == :new} id="song-modal" show on_cancel={JS.patch(~p"/admin/songs")}>
  <.live_component
    module={SongbookWeb.Admin.Components.SongFormComponent}
    id="new-song-form"
    title={@page_title}
    action={@live_action}
    patch={~p"/admin/songs"}
  />
</.modal>

<.modal
  :if={@live_action == :link_playlist}
  id="link-playlist-modal"
  show
  on_cancel={JS.patch(~p"/admin/songs")}
>
  <.live_component
    module={SongbookWeb.Admin.Components.LinkPlaylistComponent}
    id="link-playlist-form"
    patch={~p"/admin/songs"}
  />
</.modal>
