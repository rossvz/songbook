<!-- Admin Navigation Tabs -->
<div class="mb-8 border-b border-glass animate-fade-in">
  <nav class="flex gap-1" aria-label="Admin">
    <.link
      navigate={~p"/admin/songs"}
      class="admin-nav-tab"
    >
      <.icon name="hero-musical-note" class="h-4 w-4 inline-block mr-1.5" /> Songs
    </.link>
    <.link
      navigate={~p"/admin/shows"}
      class="admin-nav-tab"
    >
      <.icon name="hero-calendar-days" class="h-4 w-4 inline-block mr-1.5" /> Shows
    </.link>
    <.link
      navigate={~p"/admin/quick-searches"}
      class="admin-nav-tab admin-nav-tab-active"
    >
      <.icon name="hero-magnifying-glass" class="h-4 w-4 inline-block mr-1.5" /> Quick Searches
    </.link>
  </nav>
</div>

<!-- Header -->
<div class="mb-6 flex items-center justify-between animate-slide-up">
  <div>
    <h1 class="text-2xl font-display font-semibold text-primary">
      {@page_title}
    </h1>
    <p class="mt-1 text-sm text-secondary">
      Manage suggested search terms
    </p>
  </div>
  <button
    phx-click="regenerate"
    class="admin-button-primary"
  >
    <.icon name="hero-arrow-path" class="h-4 w-4 mr-1.5" /> Regenerate All
  </button>
</div>

<!-- Quick Searches List -->
<div
  id="quick-searches"
  phx-update="stream"
  phx-hook="StaggerList"
  class="space-y-3"
>
  <div
    :for={{id, qs} <- @streams.quick_searches}
    id={id}
    class="admin-card p-4"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="p-2.5 rounded-xl" style="background: var(--accent-primary-soft);">
          <.icon name="hero-magnifying-glass" class="w-5 h-5 text-accent" />
        </div>
        <div>
          <h3 class="font-medium text-primary">{qs.term}</h3>
          <p class="text-sm text-tertiary">
            {format_source_type(qs.source_type)} · {qs.match_count} matches
          </p>
        </div>
      </div>

      <button
        type="button"
        phx-click={JS.push("delete", value: %{id: qs.id}) |> hide("##{id}")}
        data-confirm="Remove this quick search?"
        class="p-2.5 rounded-xl text-tertiary hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors"
        title="Delete"
      >
        <.icon name="hero-trash" class="h-5 w-5" />
      </button>
    </div>
  </div>
</div>

<!-- Empty state -->
<%= if @streams.quick_searches.inserts == [] do %>
  <div class="glass rounded-2xl p-12 text-center animate-scale-in">
    <div
      class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center"
      style="background: var(--accent-primary-soft);"
    >
      <.icon name="hero-magnifying-glass" class="w-8 h-8 text-accent" />
    </div>
    <h3 class="font-display text-xl font-semibold text-primary">No quick searches</h3>
    <p class="text-secondary mt-2 mb-4">Generate quick searches from your track library.</p>
    <button phx-click="regenerate" class="admin-button-primary">
      <.icon name="hero-arrow-path" class="h-4 w-4 mr-1.5" /> Generate Quick Searches
    </button>
  </div>
<% end %>
