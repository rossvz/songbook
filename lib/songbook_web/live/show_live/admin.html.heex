<!-- Admin Navigation Tabs -->
<div class="mb-6 border-b border-gray-200 dark:border-gray-700">
  <nav class="flex space-x-8" aria-label="Admin">
    <.link
      navigate={~p"/admin/songs"}
      class="border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300"
    >
      Songs
    </.link>
    <.link
      navigate={~p"/admin/shows"}
      class="border-b-2 border-blue-500 py-4 px-1 text-sm font-medium text-blue-600 dark:text-blue-400"
    >
      Shows
    </.link>
  </nav>
</div>

<.header>
  {@page_title}
  <:actions>
    <.link patch={~p"/admin/shows/new"}>
      <.button class="bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600">New Show</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="shows"
  rows={@streams.shows}
>
  <:col :let={{_id, show}} label="Date">
    {format_date(show.date)}
  </:col>
  <:col :let={{_id, show}} label="Venue">
    {show.venue}
  </:col>
  <:col :let={{_id, show}} label="Time">
    {show.time || "TBD"}
  </:col>
  <:action :let={{_id, show}}>
    <.link patch={~p"/admin/shows/#{show}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, show}}>
    <.link
      phx-click={JS.push("delete", value: %{id: show.id}) |> hide("##{id}")}
      data-confirm="Are you sure you want to delete this show?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal
  :if={@live_action in [:new, :edit]}
  id="show-modal"
  show
  on_cancel={JS.patch(~p"/admin/shows")}
>
  <.live_component
    module={SongbookWeb.ShowLive.FormComponent}
    id={@show.id || :new}
    title={@page_title}
    action={@live_action}
    show={@show}
    patch={~p"/admin/shows"}
  />
</.modal>
