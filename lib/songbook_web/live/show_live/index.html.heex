<div class="flex flex-col -mx-4 sm:-mx-6 lg:-mx-8 pt-2 -mb-8" style="height: calc(100vh - 100px);">
  <!-- Calendar Component -->
  <div class="flex-shrink-0 max-w-xl mx-auto w-full px-4 animate-scale-in">
    <div class="glass rounded-2xl p-5">
      <!-- Month Header -->
      <div class="text-center font-display text-xl font-semibold mb-4 text-accent">
        {@calendar_data.month_name}
      </div>
      
<!-- Weekday Labels -->
      <div class="grid grid-cols-7 gap-1 mb-2">
        <div class="text-center text-xs font-medium text-tertiary">Su</div>
        <div class="text-center text-xs font-medium text-tertiary">Mo</div>
        <div class="text-center text-xs font-medium text-tertiary">Tu</div>
        <div class="text-center text-xs font-medium text-tertiary">We</div>
        <div class="text-center text-xs font-medium text-tertiary">Th</div>
        <div class="text-center text-xs font-medium text-tertiary">Fr</div>
        <div class="text-center text-xs font-medium text-tertiary">Sa</div>
      </div>
      
<!-- Calendar Grid -->
      <div class="grid grid-cols-7 gap-1.5">
        <div
          :for={day <- @calendar_data.days}
          phx-click={
            if !Map.get(day, :empty) && Map.get(day, :has_show), do: "select_date", else: nil
          }
          phx-value-date={if !Map.get(day, :empty), do: Map.get(day, :full_date)}
          class={[
            "calendar-day aspect-square flex items-center justify-center text-sm font-medium",
            if(Map.get(day, :empty), do: "bg-transparent"),
            if(Map.get(day, :is_today),
              do: "ring-2 ring-accent text-accent font-bold",
              else: "text-primary"
            ),
            if(!Map.get(day, :empty) && Map.get(day, :has_show),
              do: "cursor-pointer calendar-day-has-show hover:scale-105 transition-transform",
              else: ""
            ),
            if(Map.get(day, :is_selected),
              do: "calendar-day-active",
              else: ""
            )
          ]}
        >
          <span :if={!Map.get(day, :empty)}>{day.date}</span>
        </div>
      </div>
    </div>
  </div>
  
<!-- Filter Header -->
  <div
    :if={@selected_date}
    class="flex-shrink-0 mt-5 flex items-center justify-center gap-4 animate-fade-in"
  >
    <h2 class="text-lg font-display font-semibold text-primary">
      Shows for {format_date(@selected_date)}
    </h2>
    <button
      phx-click="clear_date_filter"
      class="btn-tactile btn-tactile-secondary text-sm px-4 py-2"
    >
      View All Upcoming
    </button>
  </div>
  
<!-- Scrollable Shows Container -->
  <div id="shows-container" class="flex-1 mt-5 overflow-y-auto px-4 pb-6" phx-hook="StaggerList">
    <div class="max-w-2xl mx-auto">
      <div class="space-y-4" id="shows-list" phx-update="stream">
        <div
          :for={{id, show} <- @streams.shows}
          id={id}
          data-stagger
          class="show-card"
          phx-hook="CardChaos"
        >
          <div class="song-card-content p-5">
            <!-- Date Header -->
            <div class="flex items-center gap-3 mb-4 pb-3 border-b border-glass">
              <div class="p-2 rounded-xl" style="background: var(--accent-primary-soft);">
                <.icon name="hero-calendar-days" class="w-5 h-5 text-accent" />
              </div>
              <h3 class="font-display text-xl font-semibold text-primary">
                {format_date(show.date)}
              </h3>
            </div>
            
<!-- Venue & Time -->
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <.icon name="hero-map-pin" class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />
                <a
                  href={google_maps_url(show)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-lg text-primary hover:text-accent transition-colors"
                >
                  {show.venue}
                </a>
              </div>

              <div :if={show.time} class="flex items-center gap-3">
                <.icon name="hero-clock" class="w-5 h-5 text-tertiary flex-shrink-0" />
                <span class="text-secondary font-medium">{show.time}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
<!-- Empty State -->
  <div :if={!@has_shows} class="flex-1 flex items-center justify-center px-4">
    <div class="glass rounded-2xl p-12 text-center animate-scale-in">
      <div
        class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center"
        style="background: var(--accent-primary-soft);"
      >
        <.icon name="hero-calendar-days" class="w-8 h-8 text-accent" />
      </div>
      <h3 class="font-display text-xl font-semibold text-primary">No upcoming shows</h3>
      <p class="text-secondary mt-2">
        Check back soon for new performance dates!
      </p>
    </div>
  </div>
</div>

<.modal :if={@live_action == :new} id="show-modal" show on_cancel={JS.patch(~p"/shows")}>
  <.live_component
    module={SongbookWeb.ShowLive.FormComponent}
    id="new-show-form"
    page_title={@page_title}
    action={@live_action}
    show={@show}
    patch={~p"/shows"}
  />
</.modal>
