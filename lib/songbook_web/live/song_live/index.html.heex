<!-- Admin Navigation Tabs -->
<div class="mb-6 border-b border-gray-200 dark:border-gray-700">
  <nav class="flex space-x-8" aria-label="Admin">
    <.link
      navigate={~p"/admin/songs"}
      class="border-b-2 border-blue-500 py-4 px-1 text-sm font-medium text-blue-600 dark:text-blue-400"
    >
      Songs
    </.link>
    <.link
      navigate={~p"/admin/shows"}
      class="border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300"
    >
      Shows
    </.link>
  </nav>
</div>

<!-- Playlist Management Section -->
<div class="mb-8 p-4 bg-gray-50 dark:bg-gray-800/50 rounded-lg border border-gray-200 dark:border-gray-700">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
      Spotify Playlist
    </h2>

    <%= if @playlist do %>
      <div class="flex items-center gap-2">
        <.button
          phx-click="sync_playlist"
          class="bg-green-600 hover:bg-green-700"
        >
          <.icon name="hero-arrow-path" class="h-4 w-4 mr-1" /> Sync Now
        </.button>
        <.button
          phx-click="unlink_playlist"
          data-confirm="Are you sure you want to unlink this playlist?"
          class="bg-red-600 hover:bg-red-700"
        >
          Unlink
        </.button>
      </div>
    <% else %>
      <.link patch={~p"/admin/songs/link-playlist"}>
        <.button class="bg-green-600 hover:bg-green-700">
          <.icon name="hero-link" class="h-4 w-4 mr-1" /> Link Playlist
        </.button>
      </.link>
    <% end %>
  </div>

  <%= if @playlist do %>
    <div class="mt-4 flex items-center gap-4">
      <img
        :if={@playlist.image_url}
        src={@playlist.image_url}
        alt={@playlist.name}
        class="h-16 w-16 rounded"
      />
      <div>
        <h3 class="font-medium text-gray-900 dark:text-gray-100">{@playlist.name}</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          {@playlist.track_count} tracks
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-1">
          Last synced: {SongbookWeb.SongLive.Index.format_sync_time(@playlist.last_synced_at)}
        </p>
        <a
          href={@playlist.external_url}
          target="_blank"
          class="text-sm text-green-600 dark:text-green-400 hover:underline mt-1 inline-flex items-center"
        >
          View on Spotify <.icon name="hero-arrow-top-right-on-square" class="h-3 w-3 ml-1" />
        </a>
      </div>
    </div>
  <% else %>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      No playlist linked. Link a Spotify playlist to enable the embedded player on the voting page.
    </p>
  <% end %>
</div>

<.header>
  Listing Songs
  <:actions>
    <.button
      phx-click="reset_votes"
      class="mr-2 bg-red-600 hover:bg-red-700"
    >
      Reset All Votes
    </.button>
    <.link patch={~p"/admin/songs/new"}>
      <.button class="bg-zinc-900 hover:bg-zinc-700 ">New Song</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="songs"
  rows={@streams.songs}
  row_click={fn {_id, song} -> JS.navigate(~p"/admin/songs/#{song}") end}
>
  <:col :let={{_id, song}} label="Artwork">
    <img src={song.album_artwork_url} alt={song.album} class="h-auto w-20" />
  </:col>

  <:col :let={{_id, song}} label="Title">{song.title}</:col>
  <:col :let={{_id, song}} label="Artist">{song.artist}</:col>
  <:col :let={{_id, song}} label="Album">{song.album}</:col>
  <:col :let={{_id, song}} label="Votes">{song.vote_count}</:col>

  <:action :let={{id, song}}>
    <.link phx-click={JS.push("delete", value: %{id: song.id}) |> hide("##{id}")}>
      Delete
    </.link>
  </:action>
</.table>

<.modal :if={@live_action == :new} id="song-modal" show on_cancel={JS.patch(~p"/admin/songs")}>
  <.live_component
    module={SongbookWeb.SongLive.FormComponent}
    id="new-song-form"
    title={@page_title}
    action={@live_action}
    patch={~p"/admin/songs"}
  />
</.modal>

<.modal
  :if={@live_action == :link_playlist}
  id="link-playlist-modal"
  show
  on_cancel={JS.patch(~p"/admin/songs")}
>
  <.live_component
    module={SongbookWeb.SongLive.LinkPlaylistComponent}
    id="link-playlist-form"
    patch={~p"/admin/songs"}
  />
</.modal>
