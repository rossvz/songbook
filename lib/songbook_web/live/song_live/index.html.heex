<!-- Admin Navigation Tabs -->
<div class="mb-6 border-b border-gray-200 dark:border-gray-700">
  <nav class="flex space-x-8" aria-label="Admin">
    <.link
      navigate={~p"/admin/songs"}
      class="border-b-2 border-blue-500 py-4 px-1 text-sm font-medium text-blue-600 dark:text-blue-400"
    >
      Songs
    </.link>
    <.link
      navigate={~p"/admin/shows"}
      class="border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300"
    >
      Shows
    </.link>
  </nav>
</div>

<.header>
  Listing Songs
  <:actions>
    <.button
      phx-click="reset_votes"
      class="mr-2 bg-red-600 hover:bg-red-700"
    >
      Reset All Votes
    </.button>
    <.link patch={~p"/admin/songs/new"}>
      <.button class="bg-zinc-900 hover:bg-zinc-700 ">New Song</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="songs"
  rows={@streams.songs}
  row_click={fn {_id, song} -> JS.navigate(~p"/admin/songs/#{song}") end}
>
  <:col :let={{_id, song}} label="Artwork">
    <img src={song.album_artwork_url} alt={song.album} class="h-auto w-20" />
  </:col>

  <:col :let={{_id, song}} label="Title">{song.title}</:col>
  <:col :let={{_id, song}} label="Artist">{song.artist}</:col>
  <:col :let={{_id, song}} label="Album">{song.album}</:col>
  <:col :let={{_id, song}} label="Votes">{song.vote_count}</:col>

  <:action :let={{id, song}}>
    <.link phx-click={JS.push("delete", value: %{id: song.id}) |> hide("##{id}")}>
      Delete
    </.link>
  </:action>
</.table>

<.modal :if={@live_action == :new} id="song-modal" show on_cancel={JS.patch(~p"/admin/songs")}>
  <.live_component
    module={SongbookWeb.SongLive.FormComponent}
    id="new-song-form"
    title={@page_title}
    action={@live_action}
    patch={~p"/admin/songs"}
  />
</.modal>
