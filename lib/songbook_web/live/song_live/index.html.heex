<.header>
  Listing Songs
  <:actions>
    <.button
      phx-click="reset_votes"
      class="mr-2 bg-red-600 hover:bg-red-700"
    >
      Reset All Votes
    </.button>
    <.link patch={~p"/songs/new"}>
      <.button>New Song</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="songs"
  rows={@streams.songs}
  row_click={fn {_id, song} -> JS.navigate(~p"/songs/#{song}") end}
>
  <:col :let={{_id, song}} label="Artwork">
    <img src={song.album_artwork_url} alt={song.album} class="h-auto w-20" />
  </:col>

  <:col :let={{_id, song}} label="Title">{song.title}</:col>
  <:col :let={{_id, song}} label="Artist">{song.artist}</:col>
  <:col :let={{_id, song}} label="Album">{song.album}</:col>
  <:col :let={{_id, song}} label="Votes">{song.votes}</:col>

  <:action :let={{id, song}}>
    <.link
      phx-click={JS.push("delete", value: %{id: song.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal :if={@live_action in [:new, :edit]} id="song-modal" show on_cancel={JS.patch(~p"/songs")}>
  <.live_component
    module={SongbookWeb.SongLive.FormComponent}
    id={@song.id || :new}
    title={@page_title}
    action={@live_action}
    results={[]}
    song={@song}
    patch={~p"/songs"}
  />
</.modal>
