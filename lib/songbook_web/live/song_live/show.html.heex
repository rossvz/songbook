<.header>
  Song {@track.id}
  <:subtitle>This is a song record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/songs/#{@track}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit song</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Title">{@track.title}</:item>
  <:item title="Artist">{@track.artist}</:item>
  <:item title="Album">{@track.album}</:item>
  <:item title="Album artwork url">{@track.album_artwork_url}</:item>
  <:item title="Spotify">{@track.spotify_id}</:item>
</.list>

<.back navigate={~p"/songs"}>Back to songs</.back>

<.modal
  :if={@live_action == :edit}
  id="song-modal"
  show
  on_cancel={JS.patch(~p"/songs/#{@track}")}
>
  <.live_component
    module={SongbookWeb.SongLive.FormComponent}
    id={@track.id}
    title={@page_title}
    action={@live_action}
    track={@track}
    patch={~p"/songs/#{@track}"}
  />
</.modal>
