<.header>
  {@track.title}
  <:subtitle>by {@track.artist}</:subtitle>
  <:actions>
    <.link patch={~p"/admin/songs/#{@track}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit song</.button>
    </.link>
  </:actions>
</.header>

<div :if={@track.album_artwork_url} class="mb-6">
  <img
    src={@track.album_artwork_url}
    alt={"#{@track.title} album artwork"}
    class="rounded-lg shadow-lg max-w-md"
  />
</div>

<.list>
  <:item title="Album">{@track.album}</:item>
  <:item title="Spotify ID">{@track.spotify_id}</:item>
</.list>

<.back navigate={~p"/admin/songs"}>Back to songs</.back>

<.modal
  :if={@live_action == :edit}
  id="song-modal"
  show
  on_cancel={JS.patch(~p"/admin/songs/#{@track}")}
>
  <.live_component
    module={SongbookWeb.SongLive.FormComponent}
    id={@track.id}
    title={@page_title}
    action={@live_action}
    track={@track}
    patch={~p"/admin/songs/#{@track}"}
  />
</.modal>
