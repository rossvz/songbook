<div class="max-w-3xl mx-auto pt-4">
  <!-- Song cards with physics and chaos -->
  <div
    class="space-y-4 pb-8"
    id="songs-list"
    phx-update="stream"
    phx-hook="StaggerList"
  >
    <%= for {id, song} <- @streams.songs do %>
      <div
        id={id}
        class="song-card cursor-pointer"
        phx-hook="CardChaos"
        data-stagger
        phx-click="vote"
        phx-value-id={song.id}
      >
        <!-- Album art blur background -->
        <%= if song.album_artwork_url do %>
          <div
            class="song-card-blur-bg"
            style={"background-image: url('#{song.album_artwork_url}');"}
          >
          </div>
        <% else %>
          <div
            class="song-card-gradient-bg"
            phx-hook="GradientFallback"
            data-title={song.title}
            id={"gradient-#{song.id}"}
          >
          </div>
        <% end %>

        <!-- Card content -->
        <div
          class="song-card-content p-4 sm:p-5"
          phx-hook="AdaptiveTextColor"
          id={"content-#{song.id}"}
          data-dominant-color={song.dominant_color}
        >
          <div class="flex items-center gap-3 sm:gap-4">
            <!-- Album artwork -->
            <div class="flex-shrink-0">
              <%= if song.album_artwork_url do %>
                <img
                  src={song.album_artwork_url}
                  alt={song.album}
                  class="album-art w-16 h-16 sm:w-20 sm:h-20 object-cover"
                />
              <% else %>
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-accent-soft flex items-center justify-center">
                  <.icon name="hero-musical-note" class="w-8 h-8 text-accent" />
                </div>
              <% end %>
            </div>

            <!-- Song info -->
            <div class="flex-1 min-w-0">
              <h3 class="font-display text-lg sm:text-xl font-semibold truncate adaptive-title">
                {song.title}
              </h3>
              <p class="text-base sm:text-lg font-medium mt-0.5 truncate adaptive-artist">
                {song.artist}
              </p>
              <p class="text-sm font-medium mt-0.5 truncate adaptive-album">
                {song.album}
              </p>
            </div>

            <!-- Vote button -->
            <div class="flex-shrink-0 text-center">
              <button
                type="button"
                class={[
                  "btn-vote btn-vote-sm transition-all duration-200",
                  MapSet.member?(@voted_tracks, song.id) && "voted"
                ]}
              >
                <%= if MapSet.member?(@voted_tracks, song.id) do %>
                  <.icon name="hero-check-solid" class="w-5 h-5" />
                <% else %>
                  <.icon name="hero-chevron-up-solid" class="w-5 h-5" />
                <% end %>
              </button>
              <div class="mt-1.5">
                <span class="text-lg font-bold text-primary block">
                  {song.vote_count}
                </span>
                <span class="text-xs text-tertiary">
                  {if song.vote_count == 1, do: "vote", else: "votes"}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Empty state -->
  <%= if Enum.empty?(@streams.songs.inserts) do %>
    <div class="glass rounded-2xl p-12 text-center">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-accent-soft flex items-center justify-center">
        <.icon name="hero-musical-note" class="w-8 h-8 text-accent" />
      </div>
      <h3 class="font-display text-xl font-semibold text-primary">No songs yet</h3>
      <p class="text-secondary mt-2">Check back soon for songs to vote on!</p>
    </div>
  <% end %>
</div>
