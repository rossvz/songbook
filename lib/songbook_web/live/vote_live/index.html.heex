<div class="max-w-3xl mx-auto pt-4">
  <!-- Search input -->
  <form phx-change="search" class="mb-4">
    <input
      type="text"
      name="query"
      value={@search_query}
      placeholder="Search by title, artist, or album..."
      phx-debounce="200"
      class="w-full px-4 py-3 rounded-xl bg-zinc-900/10 dark:bg-white/10 backdrop-blur border border-zinc-400 dark:border-white/20 text-primary placeholder-tertiary focus:outline-none focus:ring-2 focus:ring-accent"
    />
  </form>
  
<!-- Quick searches -->
  <div :if={@quick_searches != []} class="mb-4 flex flex-wrap items-center gap-2">
    <span class="text-sm text-tertiary">Try searching for</span>
    <button
      :for={qs <- @quick_searches}
      type="button"
      phx-click="quick_search"
      phx-value-term={qs.term}
      class="px-3 py-1.5 text-sm rounded-full bg-zinc-900/10 dark:bg-white/10 backdrop-blur border border-zinc-400 dark:border-white/20 text-secondary hover:bg-zinc-900/20 dark:hover:bg-white/20 hover:text-primary dark:hover:text-white transition-all duration-200"
    >
      {qs.term}
    </button>
  </div>
  
<!-- Song cards with physics and chaos -->
  <div
    class="space-y-4 pb-8"
    id="songs-list"
    phx-update="stream"
    phx-hook="StaggerList"
  >
    <%= for {id, song} <- @streams.songs do %>
      <div
        id={id}
        class={["song-card relative", !@is_admin && "cursor-pointer"]}
        phx-hook={if @is_admin, do: "SwipeToHide", else: "CardChaos"}
        data-stagger
        data-track-id={song.id}
        phx-click={unless @is_admin, do: "vote"}
        phx-value-id={song.id}
      >
        <%= if @is_admin do %>
          <div class="swipe-indicator absolute inset-y-0 right-0 w-16 flex items-center justify-center opacity-0 bg-gradient-to-l from-amber-500/80 to-transparent rounded-r-2xl z-10 pointer-events-none">
            <.icon name="hero-check" class="w-6 h-6 text-white" />
          </div>
        <% end %>
        <!-- Album art blur background -->
        <%= if song.album_artwork_url do %>
          <div
            class="song-card-blur-bg animate-pan"
            style={"background-image: url('#{song.album_artwork_url}'); --pan-speed: #{Enum.random(75..200)}s;"}
          >
          </div>
        <% else %>
          <div
            class="song-card-gradient-bg"
            phx-hook="GradientFallback"
            data-title={song.title}
            id={"gradient-#{song.id}"}
          >
          </div>
        <% end %>
        
<!-- Card content -->
        <div
          class="song-card-content p-4 sm:p-5"
          phx-hook="AdaptiveTextColor"
          id={"content-#{song.id}"}
          data-dominant-color={song.dominant_color}
        >
          <div class="flex items-center gap-3 sm:gap-4">
            <!-- Album artwork -->
            <.album_artwork url={song.album_artwork_url} alt={song.album} />
            
<!-- Song info -->
            <.song_info song={song} adaptive={true} />
            
<!-- Vote button -->
            <div class="shrink-0 text-center" phx-click="vote" phx-value-id={song.id}>
              <button
                type="button"
                class={[
                  "btn-vote btn-vote-sm transition-all duration-200",
                  MapSet.member?(@voted_tracks, song.id) && "voted"
                ]}
              >
                <%= if MapSet.member?(@voted_tracks, song.id) do %>
                  <.icon name="hero-check-solid" class="w-5 h-5" />
                <% else %>
                  <.icon name="hero-chevron-up-solid" class="w-5 h-5" />
                <% end %>
              </button>
              <.vote_count count={song.vote_count} class="mt-1.5" />
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
<!-- Empty state -->
  <%= if Enum.empty?(@streams.songs.inserts) do %>
    <div class="glass rounded-2xl p-12 text-center">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-accent-soft flex items-center justify-center">
        <.icon name="hero-musical-note" class="w-8 h-8 text-accent" />
      </div>
      <h3 class="font-display text-xl font-semibold text-primary">No songs yet</h3>
      <p class="text-secondary mt-2">Check back soon for songs to vote on!</p>
    </div>
  <% end %>
</div>
