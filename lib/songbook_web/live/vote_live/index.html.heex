<div class="max-w-3xl mx-auto">
  <!-- Header with display font -->
  <div class="text-center mb-10">
    <h1 class="font-display text-4xl sm:text-5xl font-semibold text-primary tracking-tight">
      Vote for Songs
    </h1>
    <p class="mt-3 text-secondary text-lg">
      Tap a song to vote. Songs with the most votes play first.
    </p>
  </div>

  <!-- Song cards with physics and chaos -->
  <div
    class="space-y-6 pb-8"
    id="songs-list"
    phx-update="stream"
    phx-hook="StaggerList"
  >
    <%= for {id, song} <- @streams.songs do %>
      <div
        id={id}
        class="song-card cursor-pointer"
        phx-hook="CardChaos"
        data-stagger
        phx-click="vote"
        phx-value-id={song.id}
      >
        <!-- Album art blur background -->
        <%= if song.album_artwork_url do %>
          <div
            class="song-card-blur-bg"
            style={"background-image: url('#{song.album_artwork_url}');"}
          >
          </div>
        <% else %>
          <div
            class="song-card-gradient-bg"
            phx-hook="GradientFallback"
            data-title={song.title}
            id={"gradient-#{song.id}"}
          >
          </div>
        <% end %>

        <!-- Card content -->
        <div class="song-card-content p-5 sm:p-6">
          <div class="flex items-center gap-4 sm:gap-5">
            <!-- Album artwork -->
            <div class="flex-shrink-0">
              <%= if song.album_artwork_url do %>
                <img
                  src={song.album_artwork_url}
                  alt={song.album}
                  class="album-art w-20 h-20 sm:w-24 sm:h-24 object-cover"
                />
              <% else %>
                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl bg-accent-soft flex items-center justify-center">
                  <.icon name="hero-musical-note" class="w-10 h-10 text-accent" />
                </div>
              <% end %>
            </div>

            <!-- Song info -->
            <div class="flex-1 min-w-0">
              <h3 class="font-display text-xl sm:text-2xl font-semibold text-primary truncate">
                {song.title}
              </h3>
              <p class="text-secondary text-base sm:text-lg mt-0.5 truncate">
                {song.artist}
              </p>
              <p class="text-tertiary text-sm mt-1 truncate">
                {song.album}
              </p>
            </div>

            <!-- Vote button -->
            <div class="flex-shrink-0 text-center">
              <button
                type="button"
                class={[
                  "btn-vote transition-all duration-200",
                  MapSet.member?(@voted_tracks, song.id) && "voted"
                ]}
              >
                <%= if MapSet.member?(@voted_tracks, song.id) do %>
                  <.icon name="hero-check-solid" class="w-6 h-6" />
                <% else %>
                  <.icon name="hero-chevron-up-solid" class="w-6 h-6" />
                <% end %>
              </button>
              <div class="mt-2">
                <span class="text-xl font-bold text-primary block">
                  {song.vote_count}
                </span>
                <span class="text-xs text-tertiary">
                  {if song.vote_count == 1, do: "vote", else: "votes"}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Empty state -->
  <%= if Enum.empty?(@streams.songs.inserts) do %>
    <div class="glass rounded-2xl p-12 text-center">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-accent-soft flex items-center justify-center">
        <.icon name="hero-musical-note" class="w-8 h-8 text-accent" />
      </div>
      <h3 class="font-display text-xl font-semibold text-primary">No songs yet</h3>
      <p class="text-secondary mt-2">Check back soon for songs to vote on!</p>
    </div>
  <% end %>
</div>
