<header class="bg-white shadow">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900">Songbook</h1>
      <nav class="flex space-x-4">
        <.link navigate={~p"/"} class="text-blue-600 hover:text-blue-800">Vote</.link>
        <.link navigate={~p"/songs"} class="text-blue-600 hover:text-blue-800">
          Manage Songs
        </.link>
      </nav>
    </div>
  </div>
</header>

<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
