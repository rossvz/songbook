<header class="bg-white dark:bg-gray-800 shadow dark:shadow-gray-900/50 transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Songbook</h1>
      <nav class="flex items-center space-x-4">
        <.link navigate={~p"/"} class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">Vote</.link>
        <.link navigate={~p"/songs"} class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">
          Manage Songs
        </.link>
        <.theme_toggle />
      </nav>
    </div>
  </div>
</header>

<main class="px-4 py-20 sm:px-6 lg:px-8 bg-white dark:bg-gray-900 min-h-screen transition-colors duration-200">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
