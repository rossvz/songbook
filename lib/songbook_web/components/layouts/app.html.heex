<header class="fixed top-0 left-0 right-0 z-50 header-glass">
  <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center">
      <nav class="flex items-center gap-2">
        <.link
          navigate={~p"/"}
          class="nav-link flex items-center gap-2"
        >
          <.icon name="hero-musical-note" class="w-5 h-5" />
          <span class="font-medium">Songs</span>
        </.link>
        <.link
          navigate={~p"/shows"}
          class="nav-link flex items-center gap-2"
        >
          <.icon name="hero-calendar-days" class="w-5 h-5" />
          <span class="font-medium">Shows</span>
        </.link>
        <.link
          navigate={~p"/about"}
          class="nav-link flex items-center gap-2"
        >
          <.icon name="hero-user" class="w-5 h-5" />
          <span class="font-medium">About</span>
        </.link>
      </nav>

      <nav class="flex items-center gap-3">
        <.theme_toggle />
        <.link
          navigate={~p"/admin/songs"}
          class="btn-tactile text-sm px-4 py-2"
        >
          Admin
        </.link>
      </nav>
    </div>
  </div>
</header>

<main class="pt-24 pb-12 px-4 sm:px-6 lg:px-8 min-h-screen">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
