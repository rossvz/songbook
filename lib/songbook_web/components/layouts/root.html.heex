<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#f8f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121010" media="(prefers-color-scheme: dark)" />
    <.live_title suffix=" · Songbook">
      {assigns[:page_title] || "Songbook"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script src={"https://maps.googleapis.com/maps/api/js?key=#{Application.get_env(:songbook, :google_maps_api_key, "")}&libraries=places"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-base antialiased min-h-screen">
    <div class="ambient-bg"></div>
    {@inner_content}
  </body>
</html>
