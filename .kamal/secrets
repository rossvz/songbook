# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Docker registry password from 1Password
KAMAL_REGISTRY_PASSWORD=$(op read "op://Shared/Docker/password" --account my.1password.com)

# Phoenix secret key base - generate a stable one and store in 1Password
# For first deploy, run: mix phx.gen.secret
# Then store in 1Password and reference here:
SECRET_KEY_BASE=$(op read "op://Private/Songbook/SECRET_KEY_BASE" --account my.1password.com)

# Postgres password for the accessory database
# Store in 1Password: op://Private/Songbook/POSTGRES_PASSWORD
POSTGRES_PASSWORD=$(op read "op://Private/Songbook/POSTGRES_PASSWORD" --account my.1password.com)

# Database URL for connecting to the Postgres accessory
# Format: ecto://postgres:PASSWORD@HOST/DATABASE
# The host is the accessory name (songbook-db) when running in Docker network
DATABASE_URL="ecto://postgres:${POSTGRES_PASSWORD}@songbook-db:5432/songbook_prod"

# Spotify API credentials
SPOTIFY_CLIENT_ID=$(op read "op://Private/Songbook/SPOTIFY_CLIENT_ID" --account my.1password.com)
SPOTIFY_SECRET_KEY=$(op read "op://Private/Songbook/SPOTIFY_SECRET_KEY" --account my.1password.com)

# Google Maps API key for Places Autocomplete
GOOGLE_MAPS_API_KEY=$(op read "op://Private/Songbook/GOOGLE_MAPS_API_KEY" --account my.1password.com)

# Admin authentication
ADMIN_USERNAME=$(op read "op://Private/Songbook/ADMIN_USERNAME" --account my.1password.com)
ADMIN_PASSWORD=$(op read "op://Private/Songbook/ADMIN_PASSWORD" --account my.1password.com)
